rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Trusted Admin Check: verified email or database record
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'gut6762@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() 
        && isValidId(userId) 
        && request.auth.uid == userId 
        && incoming().uid == request.auth.uid
        && (incoming().role == 'user' || isAdmin()); // Prevent self-promoted admin
        
      allow update: if isSignedIn() && (
        isAdmin() || (
          request.auth.uid == userId 
          && incoming().uid == existing().uid
          && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        )
      );
      
      allow delete: if isAdmin();
    }

    // 2. Conversations Collection
    match /conversations/{conversationId} {
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() 
        && isValidId(conversationId) 
        && incoming().ownerId == request.auth.uid;
        
      allow update: if isSignedIn() && (
        isAdmin() || (
          resource.data.ownerId == request.auth.uid
          && incoming().ownerId == existing().ownerId
        )
      );
      
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      // 3. Messages Subcollection (Nested inside Conversation)
      match /messages/{messageId} {
        function isParentOwner() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data.ownerId == request.auth.uid;
        }

        allow get, list: if isSignedIn() && (isParentOwner() || isAdmin());
        
        allow create: if isSignedIn() 
          && isValidId(messageId) 
          && (isParentOwner() || isAdmin()) 
          && incoming().ownerId == request.auth.uid;
          
        allow update: if isSignedIn() && (isParentOwner() || isAdmin());
        allow delete: if isSignedIn() && (isParentOwner() || isAdmin());
      }
    }

    // 4. Token & API Usage
    match /usage/{usageId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(usageId) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || (resource.data.userId == request.auth.uid && incoming().userId == existing().userId));
      allow delete: if isAdmin();
    }

    // 5. System Settings (Public read for announcements/maintenance status; Admin write)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Admins Directory
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
